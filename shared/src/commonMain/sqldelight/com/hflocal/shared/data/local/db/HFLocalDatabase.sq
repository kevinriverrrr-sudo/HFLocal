-- ============================================================
-- HFLocalDatabase: SQLDelight schema
-- ============================================================

-- ---------- downloaded_model ----------
CREATE TABLE downloaded_model (
    id              INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    model_id        TEXT    NOT NULL UNIQUE,
    author          TEXT    NOT NULL DEFAULT '',
    file_name       TEXT    NOT NULL DEFAULT '',
    file_path       TEXT    NOT NULL DEFAULT '',
    file_size_bytes INTEGER NOT NULL DEFAULT 0,
    quantization    TEXT    NOT NULL DEFAULT '',
    download_date   INTEGER NOT NULL DEFAULT 0,
    is_downloaded   INTEGER NOT NULL DEFAULT 0,
    download_progress REAL NOT NULL DEFAULT 0.0
);

selectAllDownloadedModels:
SELECT * FROM downloaded_model WHERE is_downloaded = 1 ORDER BY download_date DESC;

selectDownloadedModelById:
SELECT * FROM downloaded_model WHERE model_id = ?;

insertOrReplaceDownloadedModel:
INSERT OR REPLACE INTO downloaded_model (
    model_id, author, file_name, file_path,
    file_size_bytes, quantization, download_date,
    is_downloaded, download_progress
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateDownloadProgress:
UPDATE downloaded_model SET download_progress = ? WHERE model_id = ?;

markModelDownloaded:
UPDATE downloaded_model SET is_downloaded = 1, download_progress = 1.0 WHERE model_id = ?;

deleteDownloadedModel:
DELETE FROM downloaded_model WHERE model_id = ?;

getTotalModelsSize:
SELECT COALESCE(SUM(file_size_bytes), 0) AS total FROM downloaded_model;

-- ---------- chat_session ----------
CREATE TABLE chat_session (
    id              INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    model_id        TEXT    NOT NULL DEFAULT '',
    title           TEXT    NOT NULL DEFAULT '',
    created_at      INTEGER NOT NULL DEFAULT 0,
    updated_at      INTEGER NOT NULL DEFAULT 0,
    system_prompt   TEXT    NOT NULL DEFAULT '',
    message_count   INTEGER NOT NULL DEFAULT 0
);

selectAllChatSessions:
SELECT * FROM chat_session ORDER BY updated_at DESC;

selectChatSessionById:
SELECT * FROM chat_session WHERE id = ?;

insertChatSession:
INSERT INTO chat_session (
    model_id, title, created_at, updated_at, system_prompt, message_count
) VALUES (?, ?, ?, ?, ?, ?);

lastInsertedRowId:
SELECT last_insert_rowid() AS rowid;

updateChatSession:
UPDATE chat_session SET
    model_id = ?,
    title = ?,
    updated_at = ?,
    system_prompt = ?,
    message_count = ?
WHERE id = ?;

deleteChatSession:
DELETE FROM chat_session WHERE id = ?;

-- ---------- chat_message ----------
CREATE TABLE chat_message (
    id              INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    session_id      INTEGER NOT NULL,
    role            TEXT    NOT NULL DEFAULT 'USER',
    content         TEXT    NOT NULL DEFAULT '',
    timestamp       INTEGER NOT NULL DEFAULT 0,
    image_path      TEXT,
    is_streaming    INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (session_id) REFERENCES chat_session(id) ON DELETE CASCADE
);

selectMessagesBySessionId:
SELECT * FROM chat_message WHERE session_id = ? ORDER BY timestamp ASC, id ASC;

insertMessage:
INSERT INTO chat_message (
    session_id, role, content, timestamp, image_path, is_streaming
) VALUES (?, ?, ?, ?, ?, ?);

updateMessage:
UPDATE chat_message SET content = ?, is_streaming = ? WHERE id = ?;

deleteMessagesBySessionId:
DELETE FROM chat_message WHERE session_id = ?;

-- ---------- app_setting ----------
CREATE TABLE app_setting (
    key   TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL DEFAULT ''
);

getSettingByKey:
SELECT value FROM app_setting WHERE key = ?;

setSetting:
INSERT OR REPLACE INTO app_setting (key, value) VALUES (?, ?);

deleteSettingByKey:
DELETE FROM app_setting WHERE key = ?;

-- ---------- indexes ----------
CREATE INDEX idx_chat_message_session_id ON chat_message(session_id);
CREATE UNIQUE INDEX idx_downloaded_model_model_id ON downloaded_model(model_id);
